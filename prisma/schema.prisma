// Prisma schema — Portal de Diagnóstico BNCC Matemática (Fundamental I e II)

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Professor {
  id        String   @id @default(cuid())
  nome      String
  email     String   @unique
  senhaHash String
  createdAt DateTime @default(now())

  alunos Aluno[]
}

model Aluno {
  id         String   @id @default(cuid())
  nome       String
  usuario    String   @unique
  senhaHash  String
  anoEscolar Int // 1 a 9
  createdAt  DateTime @default(now())

  // Ponto de partida da trilha de conteúdo, definido pelo professor (código
  // BNCC, ex: EF07MA08). Só direciona onde o aluno cai ao entrar na trilha —
  // nunca bloqueia acesso às outras habilidades.
  trilhaPontoPartida String?

  // Controle de acesso ao diagnóstico (ver src/lib/acesso.ts). Alunos
  // existentes nascem MATRICULADO por padrão (retrocompatível).
  status              StatusMatricula @default(MATRICULADO)
  diagnosticoLiberado Boolean         @default(false)

  professorId String
  professor   Professor @relation(fields: [professorId], references: [id], onDelete: Cascade)

  tentativas       Tentativa[]
  tentativasTrilha TentativaQuestaoConteudo[]
  progressos       ProgressoHabilidade[]
}

// Habilidade da BNCC (ex: EF05MA01), associada a um ano, unidade temática e bimestre sugerido
model Habilidade {
  id              String @id @default(cuid())
  codigo          String @unique // EF01MA01 ... EF09MA23
  anoEscolar      Int
  unidadeTematica String // NUMEROS | ALGEBRA | GEOMETRIA | GRANDEZAS_MEDIDAS | PROBABILIDADE_ESTATISTICA
  bimestre        Int // 1 a 4
  descricao       String

  questoes Questao[]
  conteudo Conteudo?
}

model Questao {
  id            String  @id @default(cuid())
  anoEscolar    Int
  bimestre      Int
  enunciado     String
  explicacao    String
  ordem         Int     @default(0)
  ilustracaoSvg String? // SVG inline opcional (figuras geométricas, gráficos, etc.)

  habilidadeId String
  habilidade   Habilidade @relation(fields: [habilidadeId], references: [id], onDelete: Cascade)

  alternativas Alternativa[]
  respostas    Resposta[]
}

model Alternativa {
  id      String  @id @default(cuid())
  texto   String
  correta Boolean @default(false)
  ordem   Int

  questaoId String
  questao   Questao @relation(fields: [questaoId], references: [id], onDelete: Cascade)

  respostas Resposta[]
}

// --- Trilha de conteúdo adaptativa (estudo por habilidade: teoria + exemplo +
// banco de exercícios + progresso/domínio do aluno) ---
// Modelos próprios, separados do diagnóstico (Questao/Alternativa acima) para não
// misturar contextos nem exigir filtro por origem em nenhuma tela já existente.
// "QuestaoConteudo" (não "Questao") evita colidir com o model do diagnóstico.

enum NivelQuestaoConteudo {
  FACIL
  MEDIO
  APOSTILA
  DESAFIO
  AVALIACAO
}

enum TipoRespostaConteudo {
  MULTIPLA_ESCOLHA
  NUMERICA
  TEXTO
  ORDENACAO
  CONSTRUCAO
  SIMULACAO
  PROJETO
}

enum TipoErro {
  CONCEITO
  PROCEDIMENTO
  CALCULO
  INTERPRETACAO
  REPRESENTACAO
  PRE_REQUISITO
  ERRO_NAO_CLASSIFICADO
}

enum StatusDominio {
  NAO_INICIADO
  DIAGNOSTICO
  EM_APRENDIZAGEM
  EM_PRATICA
  DOMINIO_PROVISORIO
  DOMINADO
  REVISAO
  PRE_REQUISITO_PENDENTE
}

// EXPERIMENTAL: aluno recém-cadastrado, só tem acesso ao teste resumido até
// o professor matricular. MATRICULADO: acesso normal (padrão retrocompatível
// pros alunos já existentes).
enum StatusMatricula {
  EXPERIMENTAL
  MATRICULADO
}

model Conteudo {
  id               String   @id @default(cuid())
  objetivoAluno    String? // "Ao final, você consegue..."
  teoriaBase       String // markdown completo — material de consulta, não exibido inteiro por padrão
  microBlocos      Json? // blocos curtos p/ tela (CONCEITO|VISUAL|PROCEDIMENTO|ERRO_COMUM|EXEMPLO|TENTE_COMIGO)
  exemploResolvido String // markdown, passo a passo
  errosComuns      Json? // más concepções conhecidas da habilidade
  preRequisitos    Json? // códigos BNCC ou descrições de pré-requisito
  recursosVisuais  Json? // notas "*Ilustração: ...*" extraídas da teoria, estruturadas
  ordemPedagogica  Int? // ordem sugerida na trilha, pode diferir da ordem do código BNCC
  ilustracaoSvg    String? // SVG inline opcional, mesmo padrão de Questao.ilustracaoSvg
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  habilidadeId String     @unique // 1 conteúdo por habilidade
  habilidade   Habilidade @relation(fields: [habilidadeId], references: [id], onDelete: Cascade)

  questoes   QuestaoConteudo[]
  progressos ProgressoHabilidade[]
}

// Exercício aberto da trilha (fácil/médio/apostila/desafio/avaliação final).
// Formato aberto — resposta esperada em texto, sem alternativas prontas — porque é
// assim que o banco de conteúdo fornece as questões hoje. `alternativas` fica
// disponível pra quando algum item ganhar múltipla escolha de verdade.
// Metadados ricos (subhabilidade, conceito, pré-requisitos, erros prováveis, dicas)
// são opcionais e não vêm todos preenchidos pelo seed inicial — enriquecimento é
// incremental (fácil/médio/avaliação primeiro, apostila/desafio depois).
model QuestaoConteudo {
  id               String               @id @default(cuid())
  enunciado        String
  respostaEsperada String? // gabarito em texto; nulo quando o banco de conteúdo não traz
  // resposta pra avaliação final (intencional: "sem correção na hora")
  resolucao        String? // resolução comentada, quando houver
  nivel            NivelQuestaoConteudo
  tipoResposta     TipoRespostaConteudo @default(TEXTO)
  ordem            Int                  @default(0)

  subhabilidade    String? // recorte fino dentro da habilidade, ex: "adicao_de_inteiros_sinais_diferentes"
  conceitoAvaliado String?
  preRequisitos    Json? // array de códigos/descrições de pré-requisito
  errosProvaveis   Json? // array de { codigo, tipo: TipoErro, intervencao }
  dicas            Json? // array de strings, em ordem de uso

  alternativas  Json? // só usado se tipoResposta = MULTIPLA_ESCOLHA
  requerImagem  Boolean @default(false)
  recursoVisual Json?
  ilustracaoSvg String?

  podeSerDiagnostico Boolean @default(false)
  podeSerAvaliacao   Boolean @default(false)
  podeSerRevisao     Boolean @default(true)
  atividadePratica   Boolean @default(false) // construção/experimento/pesquisa — não deve virar só múltipla escolha

  conteudoId String
  conteudo   Conteudo @relation(fields: [conteudoId], references: [id], onDelete: Cascade)

  tentativas TentativaQuestaoConteudo[]
}

// Registro de cada tentativa de resposta do aluno num exercício da trilha —
// alimenta a seleção adaptativa e a classificação de padrões de erro.
model TentativaQuestaoConteudo {
  id            String    @id @default(cuid())
  resposta      Json?
  correta       Boolean
  tipoErro      TipoErro?
  confiancaErro Float? // 0 a 1 — a classificação de erro é hipótese pedagógica, não certeza
  usouDica      Boolean   @default(false)
  dicasUsadas   Int       @default(0)
  tempoMs       Int?
  autoavaliada  Boolean   @default(false) // avaliação final sem gabarito automático: o aluno
  // se autoavalia depois de responder. `correta` guarda o autorrelato — não é
  // verificação do servidor — e por isso nunca fecha DOMINADO sozinho.
  criadaEm      DateTime  @default(now())

  alunoId String
  aluno   Aluno  @relation(fields: [alunoId], references: [id], onDelete: Cascade)

  questaoConteudoId String
  questaoConteudo   QuestaoConteudo @relation(fields: [questaoConteudoId], references: [id], onDelete: Cascade)

  @@index([alunoId, questaoConteudoId])
}

// Estado de domínio do aluno em cada habilidade da trilha (1 por aluno × conteúdo).
model ProgressoHabilidade {
  id                String        @id @default(cuid())
  status            StatusDominio @default(NAO_INICIADO)
  dominio           Float         @default(0)
  acertosSemAjuda   Int           @default(0)
  errosConsecutivos Int           @default(0)
  ultimoTipoErro    TipoErro?
  proximaRevisaoEm  DateTime?
  atualizadoEm      DateTime      @updatedAt

  alunoId String
  aluno   Aluno  @relation(fields: [alunoId], references: [id], onDelete: Cascade)

  conteudoId String
  conteudo   Conteudo @relation(fields: [conteudoId], references: [id], onDelete: Cascade)

  @@unique([alunoId, conteudoId])
}

model Tentativa {
  id            String    @id @default(cuid())
  anoEscolar    Int
  bimestre      Int
  iniciadoEm    DateTime  @default(now())
  finalizadoEm  DateTime?
  totalQuestoes Int       @default(0)
  totalAcertos  Int       @default(0)

  // Teto de questões consideradas (exibidas e corrigidas), aplicado à mesma
  // lista ordenada por `ordem` — não é um banco separado. Usado pelo "teste
  // resumido" do aluno experimental (ver src/lib/acesso.ts); null = sem teto.
  limiteQuestoes Int?

  alunoId String
  aluno   Aluno  @relation(fields: [alunoId], references: [id], onDelete: Cascade)

  respostas Resposta[]

  @@index([alunoId, anoEscolar, bimestre])
}

model Resposta {
  id        String   @id @default(cuid())
  correta   Boolean
  createdAt DateTime @default(now())

  tentativaId String
  tentativa   Tentativa @relation(fields: [tentativaId], references: [id], onDelete: Cascade)

  questaoId String
  questao   Questao @relation(fields: [questaoId], references: [id], onDelete: Cascade)

  alternativaId String
  alternativa   Alternativa @relation(fields: [alternativaId], references: [id], onDelete: Cascade)

  @@unique([tentativaId, questaoId])
}
