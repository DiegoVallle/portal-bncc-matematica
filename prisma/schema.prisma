// Prisma schema — ValeEdu (trilhas de Matemática e Alfabetização, Fundamental I e II)

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Professor {
  id        String   @id @default(cuid())
  nome      String
  email     String   @unique
  senhaHash String
  createdAt DateTime @default(now())

  // PIN curto pra desbloquear uma questão da trilha depois de 3 erros — não é
  // a senha de login (evita digitar a senha real repetidamente na frente da
  // turma). Guardado em texto puro de propósito: é um PIN de sala de aula,
  // não uma credencial de conta.
  pinDesbloqueio String @default("1234")

  alunos Aluno[]
}

model Aluno {
  id         String   @id @default(cuid())
  nome       String
  usuario    String   @unique
  senhaHash  String
  anoEscolar Int // 1 a 9
  createdAt  DateTime @default(now())

  // Ponto de partida da trilha de conteúdo, definido pelo professor (código
  // BNCC, ex: EF07MA08). Só direciona onde o aluno cai ao entrar na trilha —
  // nunca bloqueia acesso às outras habilidades.
  trilhaPontoPartida String?

  // Controle de acesso ao diagnóstico (ver src/lib/acesso.ts). Alunos
  // existentes nascem MATRICULADO por padrão (retrocompatível).
  status              StatusMatricula @default(MATRICULADO)
  diagnosticoLiberado Boolean         @default(false)

  // Qual trilha este aluno estuda — decidido pelo professor no cadastro.
  // MATEMATICA (padrão, retrocompatível) segue o fluxo normal de
  // diagnóstico/matrícula/trilha de conteúdo. ALFABETIZACAO pula esse fluxo
  // inteiro (não faz sentido pra criança de 5-8 anos ainda não alfabetizada)
  // e vai direto pra Trilha de Alfabetização — ver painel/page.tsx.
  trilhaTipo TrilhaTipo @default(MATEMATICA)

  professorId String
  professor   Professor @relation(fields: [professorId], references: [id], onDelete: Cascade)

  tentativas       Tentativa[]
  tentativasTrilha TentativaQuestaoConteudo[]
  progressos       ProgressoHabilidade[]

  tentativasFonicas TentativaAtividadeFonica[]
  progressosFonicos ProgressoFonico[]
}

// Habilidade da BNCC (ex: EF05MA01), associada a um ano, unidade temática e bimestre sugerido
model Habilidade {
  id              String @id @default(cuid())
  codigo          String @unique // EF01MA01 ... EF09MA23
  anoEscolar      Int
  unidadeTematica String // NUMEROS | ALGEBRA | GEOMETRIA | GRANDEZAS_MEDIDAS | PROBABILIDADE_ESTATISTICA
  bimestre        Int // 1 a 4
  descricao       String

  questoes Questao[]
  conteudo Conteudo?
}

model Questao {
  id            String  @id @default(cuid())
  anoEscolar    Int
  bimestre      Int
  enunciado     String
  explicacao    String
  ordem         Int     @default(0)
  ilustracaoSvg String? // SVG inline opcional (figuras geométricas, gráficos, etc.)

  habilidadeId String
  habilidade   Habilidade @relation(fields: [habilidadeId], references: [id], onDelete: Cascade)

  alternativas Alternativa[]
  respostas    Resposta[]
}

model Alternativa {
  id      String  @id @default(cuid())
  texto   String
  correta Boolean @default(false)
  ordem   Int

  questaoId String
  questao   Questao @relation(fields: [questaoId], references: [id], onDelete: Cascade)

  respostas Resposta[]
}

// --- Trilha de conteúdo adaptativa (estudo por habilidade: teoria + exemplo +
// banco de exercícios + progresso/domínio do aluno) ---
// Modelos próprios, separados do diagnóstico (Questao/Alternativa acima) para não
// misturar contextos nem exigir filtro por origem em nenhuma tela já existente.
// "QuestaoConteudo" (não "Questao") evita colidir com o model do diagnóstico.

enum NivelQuestaoConteudo {
  FACIL
  MEDIO
  APOSTILA
  DESAFIO
  AVALIACAO
}

enum TipoRespostaConteudo {
  MULTIPLA_ESCOLHA
  NUMERICA
  TEXTO
  ORDENACAO
  CONSTRUCAO
  SIMULACAO
  PROJETO
}

enum TipoErro {
  CONCEITO
  PROCEDIMENTO
  CALCULO
  INTERPRETACAO
  REPRESENTACAO
  PRE_REQUISITO
  ERRO_NAO_CLASSIFICADO
}

enum StatusDominio {
  NAO_INICIADO
  DIAGNOSTICO
  EM_APRENDIZAGEM
  EM_PRATICA
  DOMINIO_PROVISORIO
  DOMINADO
  REVISAO
  PRE_REQUISITO_PENDENTE
}

// EXPERIMENTAL: aluno recém-cadastrado, só tem acesso ao teste resumido até
// o professor matricular. MATRICULADO: acesso normal (padrão retrocompatível
// pros alunos já existentes).
enum StatusMatricula {
  EXPERIMENTAL
  MATRICULADO
}

enum TrilhaTipo {
  MATEMATICA
  ALFABETIZACAO
}

model Conteudo {
  id               String   @id @default(cuid())
  objetivoAluno    String? // "Ao final, você consegue..."
  teoriaBase       String // markdown completo — material de consulta, não exibido inteiro por padrão
  microBlocos      Json? // blocos curtos p/ tela (CONCEITO|VISUAL|PROCEDIMENTO|ERRO_COMUM|EXEMPLO|TENTE_COMIGO)
  exemploResolvido String // markdown, passo a passo
  errosComuns      Json? // más concepções conhecidas da habilidade
  preRequisitos    Json? // códigos BNCC ou descrições de pré-requisito
  recursosVisuais  Json? // notas "*Ilustração: ...*" extraídas da teoria, estruturadas
  ordemPedagogica  Int? // ordem sugerida na trilha, pode diferir da ordem do código BNCC
  ilustracaoSvg    String? // SVG inline opcional, mesmo padrão de Questao.ilustracaoSvg
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  habilidadeId String     @unique // 1 conteúdo por habilidade
  habilidade   Habilidade @relation(fields: [habilidadeId], references: [id], onDelete: Cascade)

  questoes   QuestaoConteudo[]
  progressos ProgressoHabilidade[]
}

// Exercício aberto da trilha (fácil/médio/apostila/desafio/avaliação final).
// Formato aberto — resposta esperada em texto, sem alternativas prontas — porque é
// assim que o banco de conteúdo fornece as questões hoje. `alternativas` fica
// disponível pra quando algum item ganhar múltipla escolha de verdade.
// Metadados ricos (subhabilidade, conceito, pré-requisitos, erros prováveis, dicas)
// são opcionais e não vêm todos preenchidos pelo seed inicial — enriquecimento é
// incremental (fácil/médio/avaliação primeiro, apostila/desafio depois).
model QuestaoConteudo {
  id               String               @id @default(cuid())
  enunciado        String
  respostaEsperada String? // gabarito em texto; nulo quando o banco de conteúdo não traz
  // resposta pra avaliação final (intencional: "sem correção na hora")
  resolucao        String? // resolução comentada, quando houver
  nivel            NivelQuestaoConteudo
  tipoResposta     TipoRespostaConteudo @default(TEXTO)
  ordem            Int                  @default(0)

  subhabilidade    String? // recorte fino dentro da habilidade, ex: "adicao_de_inteiros_sinais_diferentes"
  conceitoAvaliado String?
  preRequisitos    Json? // array de códigos/descrições de pré-requisito
  errosProvaveis   Json? // array de { codigo, tipo: TipoErro, intervencao }
  dicas            Json? // array de strings, em ordem de uso

  alternativas  Json? // só usado se tipoResposta = MULTIPLA_ESCOLHA
  requerImagem  Boolean @default(false)
  recursoVisual Json?
  ilustracaoSvg String?

  // Atividade interativa opcional (Fase 4): { tipo: "ORDENACAO"|"LIGAR_PARES"|
  // "CLASSIFICACAO", ... dados específicos do tipo }. Quando presente, a tela
  // de exercício renderiza essa atividade em vez do card padrão de múltipla
  // escolha — mas a questão continua tendo `alternativas` como fallback (não
  // é obrigatório ter as duas). Ver src/lib/trilha.ts (tipos + seleção) e
  // src/app/aluno/trilha/[habilidadeCodigo]/exercicios/[questaoId]/AtividadeInterativa.tsx.
  atividadeInterativa Json?

  podeSerDiagnostico Boolean @default(false)
  podeSerAvaliacao   Boolean @default(false)
  podeSerRevisao     Boolean @default(true)
  atividadePratica   Boolean @default(false) // construção/experimento/pesquisa — não deve virar só múltipla escolha

  conteudoId String
  conteudo   Conteudo @relation(fields: [conteudoId], references: [id], onDelete: Cascade)

  tentativas TentativaQuestaoConteudo[]
}

// Registro de cada tentativa de resposta do aluno num exercício da trilha —
// alimenta a seleção adaptativa e a classificação de padrões de erro.
model TentativaQuestaoConteudo {
  id            String    @id @default(cuid())
  resposta      Json?
  correta       Boolean
  tipoErro      TipoErro?
  confiancaErro Float? // 0 a 1 — a classificação de erro é hipótese pedagógica, não certeza
  usouDica      Boolean   @default(false)
  dicasUsadas   Int       @default(0)
  tempoMs       Int?
  autoavaliada  Boolean   @default(false) // avaliação final sem gabarito automático: o aluno
  // se autoavalia depois de responder. `correta` guarda o autorrelato — não é
  // verificação do servidor — e por isso nunca fecha DOMINADO sozinho.
  criadaEm      DateTime  @default(now())

  // Depois de 3 tentativas erradas, a questão fica bloqueada (sem revelar a
  // resposta) até o professor digitar o PIN dele (Professor.pinDesbloqueio).
  // Marcado na tentativa que esgotou as 3 chances — sem isso, a questão não
  // conta como "resolvida" pra fins de avançar/pular pra próxima.
  desbloqueadaPeloProfessor Boolean @default(false)

  alunoId String
  aluno   Aluno  @relation(fields: [alunoId], references: [id], onDelete: Cascade)

  questaoConteudoId String
  questaoConteudo   QuestaoConteudo @relation(fields: [questaoConteudoId], references: [id], onDelete: Cascade)

  @@index([alunoId, questaoConteudoId])
}

// Estado de domínio do aluno em cada habilidade da trilha (1 por aluno × conteúdo).
model ProgressoHabilidade {
  id                String        @id @default(cuid())
  status            StatusDominio @default(NAO_INICIADO)
  dominio           Float         @default(0)
  acertosSemAjuda   Int           @default(0)
  errosConsecutivos Int           @default(0)
  ultimoTipoErro    TipoErro?
  proximaRevisaoEm  DateTime?
  atualizadoEm      DateTime      @updatedAt

  alunoId String
  aluno   Aluno  @relation(fields: [alunoId], references: [id], onDelete: Cascade)

  conteudoId String
  conteudo   Conteudo @relation(fields: [conteudoId], references: [id], onDelete: Cascade)

  @@unique([alunoId, conteudoId])
}

// --- Trilha de Alfabetização (Fase 0 — rascunho de schema, NÃO migrado ainda) ---
// Público-alvo: crianças de 5 a 8 anos ainda não alfabetizadas. Diferente da
// trilha de Matemática, o aluno não lê nem digita: toda instrução é falada
// (TTS) e boa parte das respostas são clique-em-imagem ou fala (STT, Web
// Speech API pt-BR) — por isso são modelos novos, não uma adaptação de
// QuestaoConteudo/Alternativa. Progressão única por nível fônico (não
// separada por etapa BNCC), ponto de partida definido pelo professor, mesmo
// padrão de Aluno.trilhaPontoPartida. Ver src/lib/alfabetizacao.ts para a
// progressão pedagógica e o mapeamento de códigos BNCC.

enum NivelFonico {
  CONSCIENCIA_RIMA
  CONSCIENCIA_SILABICA
  CONSCIENCIA_FONEMICA
  CORRESPONDENCIA_VOGAIS
  CORRESPONDENCIA_CONSOANTES
  SILABAS_SIMPLES
  PALAVRAS_SIMPLES
  ENCONTROS_E_DIGRAFOS
  PALAVRAS_COMPLEXAS
  FRASES_E_TEXTOS
}

enum TipoAtividadeFonica {
  RIMA // reconhecer/apontar palavras que rimam
  SEGMENTACAO_SILABICA // contar/bater sílabas
  SOM_INICIAL // identificar o som inicial de uma palavra
  CORRESPONDENCIA_SOM_LETRA // ouvir o som, apontar a letra/grafema
  LEITURA_SILABA // ler sílaba em voz alta (STT)
  MONTAR_PALAVRA // montar palavra a partir de sílabas (clique/arraste)
  LEITURA_PALAVRA // ler palavra em voz alta (STT)
  LEITURA_FRASE // ler frase curta em voz alta (STT)
}

enum TipoErroFonico {
  DISCRIMINACAO_SONORA // confunde sons parecidos (ex: /p/ e /b/)
  TROCA_GRAFEMA // reconhece o som mas erra a letra
  OMISSAO // pula sílaba/fonema
  INVERSAO // troca a ordem de sílabas/letras
  SEGMENTACAO // erra a divisão da palavra em partes
  ERRO_NAO_CLASSIFICADO
}

// Um "conteúdo" aqui é um nível da progressão fônica, não uma habilidade BNCC
// isolada — vários códigos BNCC podem mapear pro mesmo nível (ver
// src/lib/alfabetizacao.ts). `codigoBncc` é referência/rastreabilidade, não
// chave de agrupamento como em Habilidade/Conteudo da trilha de matemática.
model ConteudoAlfabetizacao {
  id              String      @id @default(cuid())
  nivel           NivelFonico @unique
  codigoBncc      String? // código(s) BNCC de referência, quando houver 1:1 claro
  ordemPedagogica Int         @unique
  objetivoAluno   String?
  instrucaoAudio  String // texto lido por TTS — o aluno não lê a tela
  ilustracaoSvg   String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  atividades AtividadeFonica[]
  progressos ProgressoFonico[]
}

model AtividadeFonica {
  id             String              @id @default(cuid())
  tipo           TipoAtividadeFonica
  instrucaoAudio String // TTS
  alvoTexto      String // palavra/sílaba/fonema/frase alvo — usado tanto pra
  // renderizar imagem/opções quanto pra validar a transcrição do STT
  opcoes         Json? // opções clicáveis (ex: 3 imagens, 1 correta), quando aplicável
  ilustracaoSvg  String?
  ordem          Int                 @default(0)

  conteudoId String
  conteudo   ConteudoAlfabetizacao @relation(fields: [conteudoId], references: [id], onDelete: Cascade)

  tentativas TentativaAtividadeFonica[]
}

// Registro de cada tentativa — mesmo espírito de TentativaQuestaoConteudo,
// mas com campos de voz em vez de alternativa/resposta em texto.
model TentativaAtividadeFonica {
  id             String          @id @default(cuid())
  respostaClique Json? // quando a interação é clique/seleção (opções)
  transcricaoVoz String? // texto reconhecido pelo STT, quando aplicável
  confiancaVoz   Float? // confiança relatada pela API de reconhecimento (0-1)
  correta        Boolean
  tipoErro       TipoErroFonico?
  tempoMs        Int?
  criadaEm       DateTime        @default(now())

  alunoId String
  aluno   Aluno  @relation(fields: [alunoId], references: [id], onDelete: Cascade)

  atividadeId String
  atividade   AtividadeFonica @relation(fields: [atividadeId], references: [id], onDelete: Cascade)

  @@index([alunoId, atividadeId])
}

// Estado de domínio do aluno em cada nível fônico (1 por aluno × nível).
// Reaproveita StatusDominio (mesmo enum da trilha de matemática).
model ProgressoFonico {
  id           String        @id @default(cuid())
  status       StatusDominio @default(NAO_INICIADO)
  dominio      Float         @default(0)
  atualizadoEm DateTime      @updatedAt

  alunoId String
  aluno   Aluno  @relation(fields: [alunoId], references: [id], onDelete: Cascade)

  conteudoId String
  conteudo   ConteudoAlfabetizacao @relation(fields: [conteudoId], references: [id], onDelete: Cascade)

  @@unique([alunoId, conteudoId])
}

model Tentativa {
  id            String    @id @default(cuid())
  anoEscolar    Int
  bimestre      Int
  iniciadoEm    DateTime  @default(now())
  finalizadoEm  DateTime?
  totalQuestoes Int       @default(0)
  totalAcertos  Int       @default(0)

  // Teto de questões consideradas (exibidas e corrigidas), aplicado à mesma
  // lista ordenada por `ordem` — não é um banco separado. Usado pelo "teste
  // resumido" do aluno experimental (ver src/lib/acesso.ts); null = sem teto.
  limiteQuestoes Int?

  alunoId String
  aluno   Aluno  @relation(fields: [alunoId], references: [id], onDelete: Cascade)

  respostas Resposta[]

  @@index([alunoId, anoEscolar, bimestre])
}

model Resposta {
  id        String   @id @default(cuid())
  correta   Boolean
  createdAt DateTime @default(now())

  tentativaId String
  tentativa   Tentativa @relation(fields: [tentativaId], references: [id], onDelete: Cascade)

  questaoId String
  questao   Questao @relation(fields: [questaoId], references: [id], onDelete: Cascade)

  alternativaId String
  alternativa   Alternativa @relation(fields: [alternativaId], references: [id], onDelete: Cascade)

  @@unique([tentativaId, questaoId])
}
