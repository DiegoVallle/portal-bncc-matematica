# Copie este arquivo para .env e preencha com seus valores reais.

# Connection string do Postgres (ex: Neon, Supabase, Vercel Postgres, Railway).
# Formato: postgresql://usuario:senha@host/banco?sslmode=require
DATABASE_URL="postgresql://usuario:senha@host/banco?sslmode=require"

# Segredo usado para assinar o cookie de sessão (professor/aluno).
# Gere um novo com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="troque-por-um-valor-aleatorio-de-32-bytes"
